# docker-mailserver configuration for a self-managed domain mail appliance.
# Runtime host/domain values are supplied by compose.prod.yaml from .env.

ACCOUNT_PROVISIONER=FILE
ENABLE_IMAP=1
ENABLE_POP3=0

ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=1
ENABLE_DNSBL=1
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1
ENABLE_MTA_STS=1

SSL_TYPE=letsencrypt
TLS_LEVEL=modern
SPOOF_PROTECTION=1
PERMIT_DOCKER=none

POSTFIX_INET_PROTOCOLS=ipv4
DOVECOT_INET_PROTOCOLS=ipv4
POSTSCREEN_ACTION=enforce
MOVE_SPAM_TO_JUNK=1
MARK_SPAM_AS_READ=0

ENABLE_QUOTAS=1
POSTFIX_MAILBOX_SIZE_LIMIT=0
POSTFIX_MESSAGE_SIZE_LIMIT=52428800

LOG_LEVEL=info
DMS_DEBUG=0
