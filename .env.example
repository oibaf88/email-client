# Optional localhost runtime settings.
APP_ENV=local
APP_RELEASE=2.1.0
DATABASE_PATH=data/email-client.db
SESSION_TTL_SECONDS=7200

# Optional. If omitted, a random key is generated at each application start.
# Keeping it blank means mailbox credentials in the server-side session become
# inaccessible after restart, which is a reasonable local-security default.
FLASK_SECRET_KEY=

# IMAP/SMTP hosts are configured in the web UI and saved to local SQLite.
# Mailbox passwords are NOT stored in this file or in SQLite.
