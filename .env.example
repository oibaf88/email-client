# Application boundary
APP_MODE=live
APP_ENV=development
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
SESSION_REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=7200
SESSION_FILE_DIR=

# Live mailbox connection
MAIL_DOMAIN=example.com
IMAP_HOST=mail.example.com
IMAP_PORT=993
SMTP_HOST=mail.example.com
SMTP_SUBMISSION_PORT=587
SENT_FOLDER=Sent

# Application limits
LOGIN_RATE_LIMIT_PER_15_MINUTES=10
SEND_RATE_LIMIT_PER_HOUR=30
MAX_MESSAGE_LIST_SIZE=50
MAX_REQUEST_BYTES=65536
MAX_SUBJECT_CHARS=200
MAX_BODY_CHARS=20000
MAX_RECIPIENTS=10
MAX_ADDRESS_CHARS=320
MAX_PASSWORD_CHARS=512
MAX_READ_MESSAGE_BYTES=2000000

# Optional Docker Mailserver appliance
MAIL_HOSTNAME=mail
MAIL_FQDN=mail.example.com
WEBMAIL_FQDN=webmail.example.com
MTA_STS_FQDN=mta-sts.example.com
CERT_NAME=mail.example.com
ACME_EMAIL=admin@example.com
POSTMASTER_ADDRESS=postmaster@example.com
DMS_IMAGE=ghcr.io/docker-mailserver/docker-mailserver:15.1.0
FIRST_MAILBOX=admin@example.com
FIRST_MAILBOX_PASSWORD=replace-before-bootstrap
