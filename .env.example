# Optional local configuration.
# Copy this file to .env only if you want to override defaults.

APP_ENV=local
APP_RELEASE=2.0.0
DATABASE_PATH=data/email-client.db
LOCAL_ADDRESS=local@localhost.invalid

# Optional. If blank or omitted, a random key is generated each time the app starts.
# For a stable browser session between restarts, use at least 32 random characters.
FLASK_SECRET_KEY=
